# Project-level ignores for MOSAIC.
# Python/venv/tooling basics are covered by the repository-root .gitignore.

# --- Secrets and credentials ---
.env
.env.*
!.env.example
*.pem
*.key
# GCP service-account keys — never commit
service-account*.json
gcp-*.json
credentials*.json
application_default_credentials.json
.gcloud/

# --- Data ---
# Leading **/ so these match under the mosaic/ package dir too.
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
*.parquet
*.feather
*.duckdb
*.sqlite
*.sqlite3

# --- Vector stores / indexes ---
.chroma/
chroma_db/
faiss_index/
*.faiss
*.index
qdrant_storage/
lancedb/

# --- Model and embedding artifacts ---
models/
checkpoints/
*.ckpt
*.safetensors
*.gguf
*.bin
*.pt
*.onnx

# --- LangGraph / LangMem local state ---
.langgraph_api/
.langgraph/
langgraph_checkpoints/
*.checkpoint.sqlite
memory_store/
.langmem/

# --- Evaluation outputs ---
**/evaluation/results/
**/evaluation/runs/
*.eval.json

# --- Notebooks ---
**/notebooks/**/*.html
**/notebooks/scratch/

# --- Logs and local runtime ---
logs/
*.log
.cache/
tmp/

# --- Terraform (deployment/gcp) ---
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
